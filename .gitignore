logs/
*.log

# Test/Tool caches
.pytest_cache/
.mypy_cache/
.cache/

# OS files
.DS_Store
Thumbs.db

# Archives
*.tar.gz
*.zip

# Local configs and secrets (use a sample file for version control)
config.yaml
.env
.env.*

# Misc local folders that should not be committed
backups/
backup/
tmp/
temp/
